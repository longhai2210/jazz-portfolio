generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Profile {
  id            String   @id @default(uuid())
  name          Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  title         Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  introduction  Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  bio           Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  avatarUrl     String?  @map("avatar_url")
  backgroundUrl String?  @map("background_url")
  socialLinks   Json     @default("{}")
  contactInfo   Json     @default("{}") @map("contact_info")
  isMusicEnabled Boolean  @default(true) @map("is_music_enabled")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}


model Category {
  id        String         @id @default(uuid())
  name      Json           @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  slug      String         @unique
  type      String         @default("CUSTOM")
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  isDeleted Boolean        @default(false) @map("is_deleted")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  items     CategoryItem[]

  @@index([isDeleted, isActive, sortOrder])
  @@map("categories")
}

model CategoryItem {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  title       Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  description Json     @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  metadata    Json     @default("{}")
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isDeleted, isActive, sortOrder])
  @@map("category_items")
}

model Track {
  id              String   @id @default(uuid())
  title           String
  artist          String
  s3Key           String   @map("s3_key")
  cloudfrontUrl   String   @map("cloudfront_url")
  durationSeconds Int      @default(0) @map("duration_seconds")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("tracks")
}

model Media {
  id            String   @id @default(uuid())
  filename      String
  s3Key         String   @map("s3_key")
  cloudfrontUrl String   @map("cloudfront_url")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  context       String   @default("GENERAL")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("media")
}

model ContactSubmission {
  id          String   @id @default(uuid())
  senderName  String   @map("sender_name") @db.VarChar(100)
  senderEmail String   @map("sender_email") @db.VarChar(254)
  subject     String   @db.VarChar(200)
  messageBody String   @map("message_body") @db.VarChar(5000)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isRead, createdAt])
  @@map("contact_submissions")
}

model SiteSettings {
  id                      String   @id @default(uuid())
  isContactFormEnabled    Boolean  @default(true) @map("is_contact_form_enabled")
  mailProvider            String   @default("resend") @map("mail_provider")
  mailFrom                String   @default("") @map("mail_from")
  mailTo                  String   @default("") @map("mail_to")
  isBlogEnabled           Boolean  @default(false) @map("is_blog_enabled")
  areCommentsEnabled      Boolean  @default(false) @map("are_comments_enabled")
  commentModerationMode   String   @default("ALL") @map("comment_moderation_mode")
  isCommentCaptchaEnabled Boolean  @default(false) @map("is_comment_captcha_enabled")
  commentAutoCloseDays    Int      @default(0) @map("comment_auto_close_days")
  commentMaxPerPost       Int      @default(500) @map("comment_max_per_post")
  commentSpamThreshold    Int      @default(60) @map("comment_spam_threshold")
  commentNotifyEmail      Boolean  @default(true) @map("comment_notify_email")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Post {
  id                 String    @id @default(uuid())
  slug               String    @unique
  title              Json      @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  excerpt            Json      @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  content            Json      @default("{\"en\": \"\", \"vi\": \"\", \"ja\": \"\"}")
  coverImageUrl      String?   @map("cover_image_url")
  status             String    @default("DRAFT")
  tags               String[]  @default([])
  readingMinutes     Int       @default(0) @map("reading_minutes")
  areCommentsEnabled Boolean   @default(true) @map("are_comments_enabled")
  commentsClosedAt   DateTime? @map("comments_closed_at")
  commentCount       Int       @default(0) @map("comment_count")
  viewCount          Int       @default(0) @map("view_count")
  publishedAt        DateTime? @map("published_at")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  comments           Comment[]

  @@index([isDeleted, status, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("posts")
}

model Comment {
  id          String    @id @default(uuid())
  postId      String    @map("post_id")
  parentId    String?   @map("parent_id")
  authorName  String    @map("author_name") @db.VarChar(60)
  authorEmail String    @map("author_email") @db.VarChar(254)
  body        String    @db.VarChar(2000)
  status      String    @default("PENDING")
  spamScore   Int       @default(0) @map("spam_score")
  spamReasons Json      @default("[]") @map("spam_reasons")
  ipHash      String    @map("ip_hash") @db.VarChar(64)
  userAgent   String    @default("") @map("user_agent") @db.VarChar(400)
  contentHash String    @map("content_hash") @db.VarChar(64)
  locale      String    @default("en") @db.VarChar(5)
  moderatedAt DateTime? @map("moderated_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, status, createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@index([contentHash])
  @@map("comments")
}

model CommentBlocklist {
  id        String   @id @default(uuid())
  type      String   // EMAIL | EMAIL_DOMAIN | IP_HASH | KEYWORD
  value     String   @db.VarChar(200)
  note      String   @default("") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, value])
  @@index([type])
  @@map("comment_blocklist")
}

# API (browser calls with credentials: 'include' for admin cookie auth)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Optional API base URL used only by Next.js server rendering/ISR.
# Set this to a private service address when web and API share a network;
# otherwise omit it and NEXT_PUBLIC_API_URL is used as the fallback.
API_INTERNAL_URL=http://localhost:3001/api

# Public site origin (sitemap, robots, Open Graph metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CloudFront (for media URLs)
NEXT_PUBLIC_CDN_URL=

# Cloudflare Turnstile public site key (required when CAPTCHA is enabled)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Must match the API REVALIDATE_SECRET
REVALIDATE_SECRET=replace-with-a-random-revalidation-secret-32-characters

# Note: Admin JWT is an httpOnly cookie on the API host (`jazz_access_token`).
# Nest must allow this origin via FRONTEND_URL / CORS_ORIGINS with credentials: true.
# Cross-origin local setup needs Nest COOKIE_SAME_SITE=none and COOKIE_SECURE=true.

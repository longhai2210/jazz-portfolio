# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jazz_portfolio?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=jazz-portfolio-media
AWS_CLOUDFRONT_DOMAIN=

# Frontend URL (CORS) — single origin. Cookie auth requires credentials: true.
FRONTEND_URL=http://localhost:3000

# Optional comma-separated CORS allowlist (overrides FRONTEND_URL when set)
# CORS_ORIGINS=http://localhost:3000,https://your-amplify-domain.amplifyapp.com

# Auth cookie (httpOnly name: jazz_access_token)
# Cross-origin web→api (different ports/hosts): SameSite=none + Secure=true
# Same-site (reverse proxy / same host): COOKIE_SAME_SITE=lax is fine
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Mail/Email Notifications
MAIL_PROVIDER=resend # resend | smtp
MAIL_FROM=notifications@yourdomain.com
MAIL_TO=contact@yourdomain.com

# Resend Mail Provider (if MAIL_PROVIDER=resend)
RESEND_API_KEY=re_123456789

# SMTP Mail Provider (if MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password

# Comment security (generate independent random values of at least 32 characters)
COMMENT_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
COMMENT_IP_HASH_SALT=replace-with-an-independent-random-salt-at-least-32-characters

# Optional Cloudflare Turnstile CAPTCHA secret
TURNSTILE_SECRET_KEY=

# Next.js on-demand cache invalidation (must match the web REVALIDATE_SECRET)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-random-revalidation-secret-32-characters
